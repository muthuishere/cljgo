;; bri.core.cache — the fundamental in-process cache (ADR 0093): a TTL map with
;; SINGLEFLIGHT (a stampede of concurrent misses for one key fills exactly once).
;; Pure Clojure over atoms + promise/swap-vals! + cljg.os/now — NO Go shim, NO
;; dependency.
;;
;; The `Cache` PROTOCOL is the interface: `local` is our built-in impl; a user who
;; wants redis/memcached/anything implements the SAME protocol and passes it to the
;; same fetch/put/evict/clear (owner: "provide interfaces for all — we give the
;; fundamentals, users bring the backend").
;;
;;   (require '[bri.core.cache :as cache])
;;   (def c (cache/local {:ttl 300}))
;;   (cache/fetch c :user/42 #(load-user 42))   ; miss → fill once under a stampede
;;   (cache/put c :user/42 u) (cache/evict c :user/42) (cache/clear c)
;;   ;; bring your own backend: (reify cache/Cache (-fetch [_ k f] …) …)
;;
;; Loaded as a bri namespace (ADR 0041): NO (ns …) form — the fully-qualified
;; in-ns + refer open the file, then the require.
(clojure.core/in-ns 'bri.core.cache)
(clojure.core/refer 'clojure.core)
(require '[cljg.os :as os])

(defprotocol Cache
  "The cache interface. `local` is the built-in in-process impl; implement this
  (reify/defrecord) over any store to plug in your own backend."
  (-fetch [c key f] "Return the cached value for `key`, or fill it once via (f).")
  (-put   [c key v] "Store `v` under `key`; return `v`.")
  (-evict [c key]   "Remove `key`.")
  (-clear [c]       "Remove everything."))

(defn- fresh? [e now] (and e (> (:exp e) now)))

(defn- fill-once
  "Singleflight: exactly one caller runs `f` for `key`; concurrent callers block
  on its promise and share the result. A throwing `f` is not cached — a waiter
  retries rather than wedging."
  [store inflight ttl-ms key f]
  (loop []
    (let [now (os/now)
          e   (get @store key)]
      (if (fresh? e now)
        (:v e)
        (let [p         (promise)
              [_ after] (swap-vals! inflight (fn [m] (if (contains? m key) m (assoc m key p))))]
          (if (identical? p (get after key))
            ;; we won the race → we are the single filler (re-check the store first,
            ;; in case a filler completed between our miss and our claim)
            (let [e2 (get @store key)]
              (if (fresh? e2 now)
                (do (swap! inflight dissoc key) (deliver p (:v e2)) (:v e2))
                (let [v (try (f)
                             (catch Throwable ex
                               (swap! inflight dissoc key)
                               (deliver p ::error)
                               (throw ex)))]
                  (swap! store assoc key {:v v :exp (+ now ttl-ms)})
                  (swap! inflight dissoc key)
                  (deliver p v)
                  v)))
            ;; someone else is filling → wait on their promise (retry on their error)
            (let [r (deref (get after key))]
              (if (= r ::error) (recur) r))))))))

(defn local
  "The built-in in-process cache: a TTL map with singleflight. opts:
    :ttl seconds each entry lives (default 60). Returns a `Cache`."
  ([] (local {}))
  ([{:keys [ttl] :or {ttl 60}}]
   (let [store    (atom {})
         inflight (atom {})
         ttl-ms   (* 1000 ttl)]                ; seconds → ms (fractional ttl ok)
     (reify Cache
       (-fetch [_ key f] (fill-once store inflight ttl-ms key f))
       (-put   [_ key v] (swap! store assoc key {:v v :exp (+ (os/now) ttl-ms)}) v)
       (-evict [_ key]   (swap! store dissoc key) nil)
       (-clear [_]       (reset! store {}) nil)))))

;; --- the public API: dispatches through the Cache protocol, so it works on
;; `local` AND on any user backend implementing Cache -------------------------

(defn fetch
  "Return the cached value for `key`; on a miss, fill it via (f) exactly once
  even under a concurrent stampede, cache it, and return it."
  [c key f] (-fetch c key f))

(defn put
  "Write `v` through under `key`; returns `v`."
  [c key v] (-put c key v))

(defn evict
  "Drop `key` from the cache."
  [c key] (-evict c key))

(defn clear
  "Drop every entry."
  [c] (-clear c))
