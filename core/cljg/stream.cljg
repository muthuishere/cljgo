;; cljg.stream — the ONE reducible stream abstraction (ADR 0101, spike s56),
;; shared by cljg.process (subprocess pipes) and cljg.net.http (:as :stream
;; response bodies). Two handles:
;;
;;   a READABLE stream over a Go io.Reader — reduce-able (it is Seqable, so
;;   `reduce`/`into`/`doseq`/transducers walk it a chunk at a time in constant
;;   memory, and `take`/`reduced` short-circuit the read) plus read-line /
;;   read-bytes / read-all / close;
;;   a WRITABLE stream over a Go io.Writer — write (buffered + flushed) / close
;;   (flush + EOF to the peer).
;;
;;   (require '[cljg.stream :as st])
;;   (reduce (fn [n c] (+ n (count c))) 0 readable)   ; the handle IS reducible
;;   (st/lines readable)      ; lazy seq of line strings
;;   (st/chunks readable)     ; lazy seq of []byte chunks (default 64 KiB)
;;   (st/read-line readable)  ; one line string, or nil at EOF
;;   (st/read-bytes readable) ; one []byte chunk, or nil at EOF
;;   (st/read-all readable)   ; drain the rest as one string
;;   (st/write writable "hi\n")   (st/close writable)   (st/close readable)
;;
;; The handles come from cljg.process/spawn and (cljg.net.http/request … {:as
;; :stream}); this namespace never creates one, it only operates on them. The Go
;; half (pkg/bri/stream.go) is thin shims over stdlib bufio/io; everything here
;; is portable Clojure, so it runs identically interpreted and AOT-compiled.
;; Private Go shims interned before this loads: -stream-read-bytes
;; -stream-read-line -stream-read-all -stream-chunk-seq -stream-line-seq
;; -stream-write -stream-close.
;;
;; Loaded as an embedded namespace (ADR 0041/0087): NO (ns …) form — the
;; fully-qualified in-ns + refer open the file. `read-line` is defined here
;; (callers write st/read-line) so it is excluded from the clojure.core refer —
;; it never shadows core globally (precedence principle).
(clojure.core/in-ns 'cljg.stream)
(clojure.core/refer 'clojure.core :exclude '[read-line])

(def ^:private default-chunk 65536)

;; --- reading ----------------------------------------------------------------

(defn read-bytes
  "Read one chunk of up to `n` bytes (default 64 KiB) from the readable stream,
  as a byte-array, or nil at end-of-stream. Fewer than `n` bytes is normal —
  whatever is available now."
  ([readable] (read-bytes readable default-chunk))
  ([readable n] (-stream-read-bytes readable n)))

(defn read-line
  "Read one line from the readable stream (up to a newline), WITHOUT the trailing
  newline, or nil at end-of-stream. A final unterminated line is returned as-is."
  [readable]
  (-stream-read-line readable))

(defn read-all
  "Drain the rest of the readable stream into one string."
  [readable]
  (-stream-read-all readable))

(defn chunks
  "A lazy seq of byte-array chunks (default 64 KiB each) drawn from the readable
  stream on demand — constant memory, `take`/`reduced` stop the read. This is
  what the handle's own reducibility bottoms out on."
  ([readable] (chunks readable default-chunk))
  ([readable n] (-stream-chunk-seq readable n)))

(defn lines
  "A lazy seq of line strings drawn from the readable stream on demand."
  [readable]
  (-stream-line-seq readable))

;; --- writing ----------------------------------------------------------------

(defn write
  "Write `data` (a string or byte-array) to the writable stream and flush, so the
  peer sees it immediately. Returns nil."
  [writable data]
  (-stream-write writable data))

(defn write-line
  "Write `s` followed by a newline to the writable stream, flushed. Returns nil."
  [writable s]
  (-stream-write writable (str s "\n")))

;; --- lifecycle --------------------------------------------------------------

(defn close
  "Close a stream handle (readable or writable). Closing a writable flushes it
  and sends EOF to the reader on the other end of the pipe; closing a readable
  releases the underlying reader. Idempotent. Returns nil."
  [stream]
  (-stream-close stream))
