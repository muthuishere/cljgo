;; cljg.date — time primitives (ADR 0101). Two clocks clojure.core does not
;; surface directly: a MONOTONIC nanosecond stopwatch for measuring elapsed
;; durations (immune to wall-clock adjustments) and the wall-clock epoch. The
;; `time` macro keeps its private -nano-time in clojure.core; this namespace
;; promotes the same monotonic source to a public cljg.date/nano-time and adds
;; the wall clock + elapsed helpers.
;;
;;   (require '[cljg.date :as date])
;;   (date/now)                        ; wall-clock epoch milliseconds
;;   (let [t0 (date/nano-time)] ... (date/since t0))   ; elapsed nanos so far
;;   (date/since t0 t1)                ; elapsed nanos between two readings
;;   (date/since-ms t0 t1)            ; the same, in milliseconds (a double)
;;
;; nano-time returns MONOTONIC nanoseconds since process start — only the
;; DIFFERENCE of two readings is meaningful; never treat it as a wall-clock
;; time. For wall time use `now`.
;;
;; ISO-8601 (ADR 0110 ask 4) is here too — what every protocol on the wire
;; actually carries:
;;
;;   (date/format-iso (date/now))      ; "2026-07-30T12:00:00.123Z"
;;   (date/parse-iso "2026-07-30T12:00:00Z")   ; => epoch millis
;;   (date/format (date/now) "2006-01-02")     ; a GO layout, see below
;;
;; Private Go shims interned before this loads (pkg/bri/cljg_date.go):
;; -nano-time -now-millis -format-iso -parse-iso -format-layout -parse-layout.
;;
;; Loaded as an embedded namespace (ADR 0041/0087): NO (ns …) form — the
;; fully-qualified in-ns + refer open the file. `format` is defined here
;; (callers write date/format), so it is EXCLUDED from the clojure.core refer —
;; clojure.core/format is untouched everywhere else (precedence principle).
(clojure.core/in-ns 'cljg.date)
(clojure.core/refer 'clojure.core :exclude '[format])

(defn nano-time
  "Monotonic nanoseconds since process start (the System/nanoTime analog).
  Only the difference of two readings is meaningful — pair with `since`."
  []
  (-nano-time))

(defn now
  "The current wall-clock time as epoch milliseconds (the System/currentTimeMillis
  analog)."
  []
  (-now-millis))

(defn since
  "Elapsed nanoseconds. With one reading `t0` (from `nano-time`), the elapsed
  nanos from `t0` until now. With two readings, `t1` - `t0`."
  ([t0] (- (nano-time) t0))
  ([t0 t1] (- t1 t0)))

(defn since-ms
  "Elapsed milliseconds (a double) — `since` divided by 1e6. One reading
  measures until now; two measure the interval between them."
  ([t0] (/ (double (since t0)) 1000000.0))
  ([t0 t1] (/ (double (since t0 t1)) 1000000.0)))

;; --- ISO-8601 / RFC 3339 (ADR 0110 ask 4) ------------------------------------
;;
;; The wire format. An instant is epoch MILLISECONDS here — the same integer
;; `now` returns — so these compose with the clock above and with anything that
;; already carries a timestamp as a long.

(defn format-iso
  "Render an instant (epoch milliseconds; defaults to `now`) as an ISO-8601 /
  RFC 3339 UTC string. Matches java.time.Instant.toString() at millisecond
  precision: no fractional part on a whole second, exactly three digits
  otherwise — (format-iso 0) => \"1970-01-01T00:00:00Z\",
  (format-iso 1500) => \"1970-01-01T00:00:01.500Z\"."
  ([] (format-iso (now)))
  ([millis] (-format-iso millis)))

(defn parse-iso
  "Parse an ISO-8601 / RFC 3339 timestamp into epoch milliseconds. A fractional
  part is optional and any offset is honoured, not dropped —
  (parse-iso \"2026-07-30T12:00:00+05:30\") equals
  (parse-iso \"2026-07-30T06:30:00Z\"). Throws, naming the input, if the string
  is not an instant."
  [s]
  (-parse-iso s))

(defn format
  "Render an instant (epoch milliseconds) in UTC with `layout`.

  NOTE — no JVM equivalent: `layout` is a GO reference-time layout, spelled by
  writing the reference instant Mon Jan 2 15:04:05 MST 2006 the way you want
  the output (\"2006-01-02\", \"15:04:05\", \"Jan 2 2006\"). It is NOT a
  java.time DateTimeFormatter pattern (\"yyyy-MM-dd\"), and cljgo does not
  translate one into the other — this is a Go host, and pretending otherwise
  would silently mis-format. For the portable case use `format-iso`.

  Does NOT shadow clojure.core/format, which is untouched (see the ns header)."
  [millis layout]
  (-format-layout millis layout))

(defn parse
  "Parse `s` with `layout` into epoch milliseconds — the inverse of `format`,
  and likewise a GO reference-time layout, not a java.time pattern. A layout
  carrying no zone is read as UTC. Throws, naming input and layout, on a
  mismatch."
  [s layout]
  (-parse-layout s layout))
