;; cljg.jobs — the fundamental in-process job queue (ADR 0094): a core.async
;; worker pool that runs typed job handlers off a channel. Pure Clojure over
;; clojure.core.async (ADR 0040, already shipped) + an atom for the outstanding
;; count — NO Go shim, NO dependency.
;;
;; The `Queue` PROTOCOL is the interface: `local` is our built-in in-process impl;
;; a user who wants a durable/distributed queue (Postgres, redis, SQS…) implements
;; the SAME protocol and passes it to the same submit/drain/stop/errors (owner:
;; "provide interfaces for all — we give the fundamentals, users bring the backend").
;;
;;   (require '[cljg.jobs :as jobs])
;;   (def q (jobs/local {:email/welcome (fn [{:keys [to]}] (send-welcome to))}))
;;   (jobs/submit q :email/welcome {:to "a@b.c"})   ; a worker runs the handler
;;   (jobs/drain q)                                  ; block until all jobs finish
;;   (jobs/stop q)
;;   ;; bring your own durable backend: (reify jobs/Queue (-submit [_ t p] …) …)
;;
;; Loaded as a bri namespace (ADR 0041): NO (ns …) form — the fully-qualified
;; in-ns + refer open the file, then the require.
(clojure.core/in-ns 'cljg.jobs)
(clojure.core/refer 'clojure.core)
(require '[clojure.core.async :as a])

(defprotocol Queue
  "The job-queue interface. `local` is the built-in in-process impl; implement
  this (reify/defrecord) over a durable store to plug in your own backend."
  (-submit [q type payload] "Enqueue a job of `type` carrying `payload`.")
  (-drain  [q] "Block until every submitted job has finished.")
  (-stop   [q] "Stop the workers (no further jobs are processed).")
  (-errors [q] "A vector of {:job … :error …} captured from throwing handlers."))

(defn- worker
  "One worker goroutine: pull jobs off `ch`, dispatch by :type through
  `handlers`, capture a throw, and decrement `pending` when each job settles."
  [ch handlers pending errs]
  (a/go
    (loop []
      (when-let [job (a/<! ch)]
        (try
          (when-let [h (get handlers (:type job))]
            (h (:payload job)))
          (catch Throwable e
            (swap! errs conj {:job job :error e}))
          (finally
            (swap! pending dec)))
        (recur)))))

(defn local
  "The built-in in-process queue: a core.async worker pool over `handlers`
  ({job-type handler-fn}; handler values may be vars so they stay live). opts:
    :workers  worker goroutines (default 4)
    :buffer   channel buffer (default 1024)
  Returns a `Queue`."
  ([handlers] (local handlers {}))
  ([handlers {:keys [workers buffer] :or {workers 4 buffer 1024}}]
   (let [ch      (a/chan buffer)
         pending (atom 0)
         errs    (atom [])]
     (dotimes [_ workers] (worker ch handlers pending errs))
     (reify Queue
       (-submit [_ type payload]
         (swap! pending inc)
         (a/>!! ch {:type type :payload payload})
         nil)
       (-drain [_]
         (loop [] (when (pos? @pending) (clojure.core/-sleep-ms 2) (recur))))
       (-stop [_] (a/close! ch) nil)
       (-errors [_] @errs)))))

;; --- the public API: dispatches through the Queue protocol, so it works on
;; `local` AND on any user backend implementing Queue --------------------------

(defn submit
  "Enqueue a job of `type` with `payload` (default nil); a worker runs
  (handler payload)."
  ([q type] (-submit q type nil))
  ([q type payload] (-submit q type payload)))

(defn drain
  "Block until every submitted job has finished."
  [q] (-drain q))

(defn stop
  "Stop the workers; no further jobs are processed."
  [q] (-stop q))

(defn errors
  "The jobs whose handler threw, as [{:job … :error …} …]."
  [q] (-errors q))
