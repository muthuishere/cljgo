;; cljg.data.cast — the ONE blessed data layer (ADR 0072, realizing ADR 0041 §4
;; Data T2). Connect, query, transact, migrate — API-first, functional,
;; injection-safe by construction, and IDENTICAL interpreted (cljgo dev)
;; vs AOT-compiled (CGO_ENABLED=0 static binary). Two pure-Go drivers
;; behind one API: modernc.org/sqlite (zero-install default, ADR 0057)
;; and pgx (production Postgres, ADR 0058) — a driver swap, not an API
;; fork.
;;
;; The blessed form is a SQL STRING plus positional `?` params (never
;; string-concatenated values). cljg.data.cast normalizes placeholders (`?`→`$n`
;; for Postgres) and column names (snake_case ↔ kebab-case), but NOT SQL
;; dialect (the ADR 0057 seam).
;;
;; Private Go shims interned by pkg/bri before this loads: -db-open
;; -db-close -db-query -db-exec -db-begin -db-commit -db-rollback
;; -db-migration-files -db-now -getenv.
;; `cast` is defined here (callers write db/cast) so it is EXCLUDED from the
;; clojure.core refer — it never shadows clojure.core/cast globally (the
;; precedence principle; same pattern as cljg.net.http/get).
(clojure.core/in-ns 'cljg.data.cast)
(clojure.core/refer 'clojure.core :exclude '[cast])
(require '[clojure.string :as str])

;; --- handles ----------------------------------------------------------------
;; A connection is a plain map {:cljg.data.cast/handle H :driver kw}; a tx conn is
;; the same map with the tx handle swapped in and :tx true. Every verb
;; reads the opaque handle out of it, so a db and a tx drive one API.
(defn ^:private handle [db] (:cljg.data.cast/handle db))

(defn connect
  "Open a connection pool. opts:
     :driver   :sqlite (default) | :postgres
     :database SQLite file path (default \".dev/app.db\") or \":memory:\"
     :url      Postgres URL (or set APP_DB_URL)
   With no :driver, APP_DB_URL starting \"postgres\" selects pgx, else
   SQLite — the zero-install default (ADR 0057). Returns a handle map."
  ([] (connect {}))
  ([opts]
   (let [url    (or (:url opts) (-getenv "APP_DB_URL"))
         driver (cond
                  (:driver opts)                             (:driver opts)
                  (and url (str/starts-with? url "postgres")) :postgres
                  :else                                      :sqlite)
         dsn    (if (= driver :postgres)
                  (or url (:database opts))
                  (or (:database opts) ".dev/app.db"))]
     (when (nil? dsn)
       (throw (ex-info "cljg.data.cast/connect: no Postgres URL (:url or APP_DB_URL)"
                       {:cljg.data.cast/error :cljg.data.cast/no-url})))
     {:cljg.data.cast/handle (-db-open (name driver) dsn) :driver driver})))

(defn close!
  "Close a connection pool (a no-op on a tx handle)."
  [db]
  (-db-close (handle db))
  nil)

(defn now
  "The current UTC instant as an RFC3339 string — a portable timestamp for
  created-at/updated-at columns (no Java interop, identical across modes)."
  []
  (-db-now))

;; --- reads ------------------------------------------------------------------
(defn query
  "Run a parametrized SELECT — SQL string + positional `?` params — and
  return a vector of maps (snake_case columns → kebab-case keyword keys).
  params are VARARGS: (query db sql p1 p2), not (query db sql [p1 p2]) —
  spread a collection with (apply query db sql params)."
  [db sql & params]
  (-db-query (handle db) sql (vec params) "query"))

(defn one
  "The first row of (query …) as a map, or nil."
  [db sql & params]
  (first (-db-query (handle db) sql (vec params) "one")))

(defn one!
  "Like `one`, but throws an ex-info tagged :cljg.data.cast/not-found when no row
  matches (the ADR 0041 funnel → 404)."
  [db sql & params]
  (or (first (-db-query (handle db) sql (vec params) "one!"))
      (throw (ex-info "cljg.data.cast/one!: no matching row"
                      {:cljg.data.cast/error :cljg.data.cast/not-found :sql sql}))))

;; --- writes -----------------------------------------------------------------
(defn exec!
  "Run a parametrized write (INSERT/UPDATE/DELETE/DDL). Returns
  {:rows-affected n :last-insert-id id}.
  params are VARARGS: (exec! db sql p1 p2), not (exec! db sql [p1 p2]) —
  spread a collection with (apply exec! db sql params)."
  [db sql & params]
  (-db-exec (handle db) sql (vec params) "exec!"))

(defn ^:private col-name
  "Kebab-case keyword key → snake_case column name."
  [k]
  (str/replace (name k) "-" "_"))

;; --- casts: the input gate (app-framework task 2.2) -------------------------
;; `(cast row schema)` validates + coerces untrusted input against a schema and
;; DROPS any key not declared in the schema — mass assignment is structurally off
;; the path (a request can never set columns the schema didn't name). Returns
;; (ok clean-row) / (err {field message}); `cast!` returns the clean row or throws.
;; schema is {field → type-keyword}: :string :int :long :double :bool :keyword
;; :any. Only keys PRESENT in `row` are processed (a partial cast — missing
;; fields are simply not set). Coercion mirrors form input (strings → numbers/bools).

(defn ^:private coerce-bool [v]
  (cond
    (boolean? v) v
    (nil? v)     false
    (string? v)  (contains? #{"true" "1" "yes" "on"} (str/lower-case (str/trim v)))
    :else        (boolean v)))

(defn ^:private coerce-field
  "Coerce one value against a `type` keyword. Returns [:ok v'] | [:err message]."
  [type v]
  (case type
    :any     [:ok v]
    :string  [:ok (when (some? v) (str v))]
    :keyword [:ok (when (some? v) (keyword v))]
    (:int :long) (cond
                   (integer? v) [:ok (long v)]
                   (number? v)  [:ok (long v)]
                   (string? v)  (if-let [n (parse-long (str/trim v))] [:ok n] [:err "expected an integer"])
                   :else        [:err "expected an integer"])
    :double  (cond
               (number? v) [:ok (double v)]
               (string? v) (if-let [n (parse-double (str/trim v))] [:ok n] [:err "expected a number"])
               :else       [:err "expected a number"])
    :bool    [:ok (coerce-bool v)]
    [:err (str "unknown cast type " (pr-str type))]))

(defn ^:private cast*
  "The engine: reduce `row` against `schema`, dropping undeclared keys. Returns
  [clean-row errors-map]."
  [row schema]
  (reduce (fn [[clean errs] f]
            (if (contains? row f)
              (let [[tag v] (coerce-field (get schema f) (get row f))]
                (if (= tag :ok)
                  [(assoc clean f v) errs]
                  [clean (assoc errs f v)]))
              [clean errs]))
          [{} {}]
          (keys schema)))

(defn cast
  "Validate + coerce `row` against `schema` ({field → type-keyword}), DROPPING any
  key not in the schema (mass assignment structurally off the path). Returns
  (ok clean-row) or (err {field message}). Only keys present in `row` are
  processed. Types: :string :int :long :double :bool :keyword :any."
  [row schema]
  (let [[clean errs] (cast* row schema)]
    (if (empty? errs) (ok clean) (err errs))))

(defn cast!
  "Like `cast`, but returns the clean row on success and THROWS
  cljg.data.cast/cast (ex-info with :errors) on any validation failure — the
  fail-fast form for a controller that treats bad input as a 400."
  [row schema]
  (let [[clean errs] (cast* row schema)]
    (if (empty? errs)
      clean
      (throw (ex-info "cljg.data.cast/cast: input failed validation"
                      {:cljg.data.cast/error :cljg.data.cast/cast :errors errs})))))

;; --- row-map writes ---------------------------------------------------------
;; insert!/update!/delete! BUILD the params themselves out of the caller's
;; map(s), so they call -db-exec directly (never `exec!`): the shim then knows
;; the verb the user actually wrote AND that each param is a column value, not
;; a varargs param. A collection inside a row map is therefore diagnosed as
;; G5009 ("column :a of the row map is a vector"), not as the G5008 varargs
;; misuse the user never committed.
(defn ^:private col-label
  "Names the row-map slot a param came from, for the params guard."
  [part k]
  (str "column " (pr-str k) " of the " part))

(defn insert!
  "Insert one row from a map (kebab keys → snake columns), parametrized.
  Returns {:rows-affected :last-insert-id} (SQLite fills :last-insert-id)."
  [db table row]
  (let [cols (keys row)
        sql  (str "insert into " (name table)
                  " (" (str/join ", " (map col-name cols)) ")"
                  " values (" (str/join ", " (map (constantly "?") cols)) ")")]
    (-db-exec (handle db) sql (vec (map #(get row %) cols)) "insert!"
              (vec (map (partial col-label "row map") cols)))))

(defn update!
  "Update rows matching where-map with set-map (both kebab→snake),
  parametrized. Returns {:rows-affected …}."
  [db table set-map where-map]
  (let [set-cols   (keys set-map)
        where-cols (keys where-map)
        set-cl     (str/join ", " (map #(str (col-name %) " = ?") set-cols))
        where-cl   (str/join " and " (map #(str (col-name %) " = ?") where-cols))
        sql        (str "update " (name table) " set " set-cl
                        (when (seq where-cols) (str " where " where-cl)))]
    (-db-exec (handle db) sql
              (vec (concat (map #(get set-map %) set-cols)
                           (map #(get where-map %) where-cols)))
              "update!"
              (vec (concat (map (partial col-label "set map") set-cols)
                           (map (partial col-label "where map") where-cols))))))

(defn delete!
  "Delete rows matching where-map (kebab→snake), parametrized.
  Returns {:rows-affected …}."
  [db table where-map]
  (let [where-cols (keys where-map)
        where-cl   (str/join " and " (map #(str (col-name %) " = ?") where-cols))
        sql        (str "delete from " (name table)
                        (when (seq where-cols) (str " where " where-cl)))]
    (-db-exec (handle db) sql (vec (map #(get where-map %) where-cols)) "delete!"
              (vec (map (partial col-label "where map") where-cols)))))

;; --- transactions -----------------------------------------------------------
(defn tx
  "Run (f tx-conn) in a transaction: COMMIT on normal return, ROLL BACK
  on any throw (re-raising). tx-conn drives the identical read/write
  verbs. Called on a tx handle, runs inline (no nested savepoints on the
  blessed path)."
  [db f]
  (if (:tx db)
    (f db)
    (let [t (assoc db :cljg.data.cast/handle (-db-begin (handle db)) :tx true)]
      (try
        (let [result (f t)]
          (-db-commit (handle t))
          result)
        (catch Throwable e
          (-db-rollback (handle t))
          (throw e))))))

(defn with-rollback
  "Run (f tx-conn) in a transaction that is ALWAYS rolled back — the
  per-test sandbox (Ecto-Sandbox shape, ADR 0058). Returns (f tx-conn)."
  [db f]
  (let [t (assoc db :cljg.data.cast/handle (-db-begin (handle db)) :tx true)]
    (try
      (f t)
      (finally
        (-db-rollback (handle t))))))

;; --- migrations -------------------------------------------------------------
;; Files <utc-timestamp>_<slug>.sql, applied forward-only in version order,
;; each in its own tx, tracked in schema_migrations; idempotent.
(defn ^:private ensure-migrations-table! [db]
  (exec! db (str "create table if not exists schema_migrations "
                 "(version text primary key, applied_at text not null)")))

(defn ^:private applied-set [db]
  (set (map :version (query db "select version from schema_migrations"))))

(defn migrate-status
  "Return {:applied [versions…] :pending [versions…]} for `dir`."
  [db dir]
  (ensure-migrations-table! db)
  (let [applied (applied-set db)
        files   (-db-migration-files dir)]
    {:applied (vec (sort applied))
     :pending (into [] (comp (remove #(contains? applied (:version %)))
                             (map :version))
                    files)}))

(defn migrate!
  "Apply every pending migration in `dir` (ascending version order, each
  in its own transaction), idempotently. Returns the post-run
  (migrate-status …)."
  [db dir]
  (ensure-migrations-table! db)
  (let [applied (applied-set db)
        files   (-db-migration-files dir)
        pending (remove #(contains? applied (:version %)) files)]
    (doseq [m pending]
      (tx db (fn [t]
               (exec! t (:sql m))
               (exec! t "insert into schema_migrations (version, applied_at) values (?, ?)"
                      (:version m) (-db-now)))))
    (migrate-status db dir)))
