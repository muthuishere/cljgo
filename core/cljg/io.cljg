;; cljg.io — filesystem primitives (ADR 0089). The structural file/path/dir
;; ops clojure.core lacks: slurp/spit stay clojure.core (the precedence
;; principle — cljg.io never shadows them), this namespace adds everything
;; AROUND them: filesystem structure + process exec.
;;
;;   (require '[cljg.io :as io])
;;   (io/exists? "x")      (io/directory? "d")   (io/list-files "d")
;;   (io/mkdirs "a/b/c")   (io/delete-tree! "d") (io/copy! "a" "b")
;;   (io/glob "src/*.clj") (io/walk "d")         (io/path "a" "b")
;;   (io/parent "a/b")     (io/filename "a/b.c") (io/extension "a/b.c")
;;   (io/home)             (io/cwd)              (io/temp-dir)
;;   (io/sh "git" "rev-parse" "HEAD")            ; {:out :err :exit :timed-out?}
;;   (io/exec ["cat"] {:in "hi" :timeout-ms 500})
;;   (io/sh! ["make" "build"] {:dir "app"})      ; throws on non-zero exit
;;   (io/string-writer)    (io/writer-str w)     ; in-memory *out* target
;;
;;   (io/read-bytes "logo.png")                  ; the byte route (ADR 0110)
;;   (io/write-bytes "out.bin" bs)               ; {:append true} to append
;;
;; Private Go shims interned before this loads: -fs-stat -fs-list -fs-mkdir
;; -fs-delete -fs-copy -fs-move -fs-glob -fs-walk -fs-temp-file -fs-temp-dir
;; -fs-home -fs-cwd -fs-read-bytes -fs-write-bytes
;; -path-abs -path-join -path-base -path-dir -path-ext
;; (pkg/bri/io_fs.go) and -proc-exec (pkg/bri/io_proc.go).
;;
;; Loaded as an embedded namespace (ADR 0041/0087): NO (ns …) form — the
;; fully-qualified in-ns + refer open the file.
(clojure.core/in-ns 'cljg.io)
(clojure.core/refer 'clojure.core)
(require '[clojure.string :as str])

;; --- stat / predicates -------------------------------------------------------

(defn stat
  "The file's metadata as {:dir? :file? :size :modified(epoch ms)}, or nil when
  the path does not exist (or is unreadable)."
  [path]
  (-fs-stat path))

(defn exists?   "True if `path` exists."                     [path] (some? (stat path)))
(defn file?     "True if `path` exists and is a regular file." [path] (boolean (:file? (stat path))))
(defn directory? "True if `path` exists and is a directory."  [path] (boolean (:dir? (stat path))))

(defn size
  "The file's size in bytes, or nil if `path` does not exist."
  [path]
  (:size (stat path)))

(defn modified
  "The file's last-modified time (epoch ms), or nil if `path` does not exist."
  [path]
  (:modified (stat path)))

;; --- directories -------------------------------------------------------------

(defn list-files
  "A vector of the entry NAMES (not full paths) directly under directory `path`,
  sorted. Throws if `path` is not a readable directory."
  [path]
  (-fs-list path))

(defn mkdirs
  "Create directory `path` and any missing parents (mkdir -p). Returns `path`.
  Not an error if it already exists."
  [path]
  (-fs-mkdir path)
  path)

(defn walk
  "A vector of every path under `root` (root included), depth-first. Throws if
  `root` is unreadable."
  [root]
  (-fs-walk root))

(defn glob
  "A vector of paths matching the shell `pattern` (filepath.Glob semantics:
  `*`, `?`, `[…]`), sorted. Empty when nothing matches."
  [pattern]
  (-fs-glob pattern))

;; --- mutate ------------------------------------------------------------------

(defn delete!
  "Delete a single file or empty directory `path`. Not an error if it is
  already absent. For a non-empty directory use `delete-tree!`."
  [path]
  (-fs-delete path false)
  nil)

(defn delete-tree!
  "Recursively delete `path` and everything under it (rm -rf). Not an error if
  it is already absent."
  [path]
  (-fs-delete path true)
  nil)

(defn copy!
  "Copy file `src` to `dst` (contents + mode). `dst` is overwritten. Returns
  `dst`. Single file — not a directory tree."
  [src dst]
  (-fs-copy src dst)
  dst)

(defn move!
  "Move/rename `src` to `dst` (falling back to copy+delete across filesystems).
  Returns `dst`."
  [src dst]
  (-fs-move src dst)
  dst)

;; --- paths (host filepath semantics) -----------------------------------------

(defn path
  "Join `segments` into one path with the host separator, cleaned
  (e.g. (path \"a\" \"b\" \"c\") => \"a/b/c\")."
  [& segments]
  (-path-join (vec segments)))

(defn absolute
  "`path` resolved against the current directory into an absolute, cleaned path."
  [path]
  (-path-abs path))

(defn parent
  "The parent directory of `path` (everything but the final element)."
  [path]
  (-path-dir path))

(defn filename
  "The final element of `path` (the file or directory name)."
  [path]
  (-path-base path))

(defn extension
  "The file extension of `path` including the leading dot (\"\" if none)."
  [path]
  (-path-ext path))

;; --- bytes (ADR 0110 ask 1) --------------------------------------------------
;;
;; The route between a path and BYTES. `slurp`/`spit` are the TEXT route and
;; stay clojure.core's; they are lossy for content that is not valid UTF-8
;; (invalid sequences decode to U+FFFD) — identically so on the JVM, which is
;; why the JVM answer is java.nio Files/readAllBytes rather than slurp. cljgo
;; has no java.nio, so the byte route lives here.

(defn read-bytes
  "Read the whole file at `path` and return its contents as a byte-array. Use
  this, not `slurp`, for anything that is not text: a string round-trip
  replaces every invalid UTF-8 sequence with U+FFFD and changes the length.
  Throws if the file cannot be read.

  The elements are SIGNED, exactly as the JVM's byte[] is and as
  clojure.core/byte-array already builds: a 0xFF byte reads back as -1, not
  255, so (vec (read-bytes p)) agrees with the JVM (oracle 1.12.5).

  The JVM analog is (java.nio.file.Files/readAllBytes (java.nio.file.Path/of
  path (into-array String []))); cljgo has no java.nio, so this is the route."
  [path]
  (-fs-read-bytes path))

(defn write-bytes
  "Write `data` — a byte-array or a string — to the file at `path`, creating it
  if needed, and return the number of bytes written. Truncates by default;
  with {:append true} appends instead. Throws if the file cannot be written."
  ([path data] (write-bytes path data nil))
  ([path data opts] (-fs-write-bytes path data (:append opts))))

;; --- locations / temp --------------------------------------------------------

(defn home "The current user's home directory." [] (-fs-home))
(defn cwd  "The current working directory."     [] (-fs-cwd))

(defn temp-file
  "Create a fresh temporary file and return its path. Optional `prefix`/`suffix`
  shape the name (e.g. (temp-file \"build-\" \".log\"))."
  ([] (temp-file "cljg" ""))
  ([prefix] (temp-file prefix ""))
  ([prefix suffix] (-fs-temp-file prefix suffix)))

(defn temp-dir
  "Create a fresh temporary directory and return its path. Optional `prefix`
  shapes the name."
  ([] (temp-dir "cljg"))
  ([prefix] (-fs-temp-dir prefix)))

;; --- process exec (ADR 0089 §3) ----------------------------------------------
;; Private Go shim interned before this loads (pkg/bri/io_proc.go): -proc-exec.

(defn exec
  "Run a subprocess and return {:out :err :exit :timed-out?} — never throwing on
  a non-zero exit (that's a normal result; use `sh!` to throw). `command` is a
  vector [cmd arg…]. opts (optional):
    :in         a string fed to the process's stdin
    :env        {name value} merged onto the current environment
    :dir        the working directory
    :timeout-ms kill the process after n ms (:timed-out? true, :exit -1)
  A missing/unrunnable binary throws (it never ran)."
  ([command] (exec command {}))
  ([command opts] (-proc-exec (vec command) opts)))

(defn sh
  "Convenience over `exec` for the common shape: pass the command + args as
  varargs, get the same {:out :err :exit :timed-out?} map back.
    (sh \"git\" \"rev-parse\" \"HEAD\")
  For stdin/env/dir/timeout use `exec` with an opts map."
  [& command]
  (exec (vec command)))

(defn sh!
  "Like `sh`, but THROWS (ex-info) if the command exits non-zero or times out —
  for the script style where a failed step should abort. Returns the same result
  map on success. Takes a command vector + optional opts (like `exec`)."
  ([command] (sh! command {}))
  ([command opts]
   (let [{:keys [exit err timed-out?] :as r} (exec command opts)]
     (when (not= 0 exit)
       (throw (ex-info (str "cljg.io: command failed"
                            (when timed-out? " (timed out)")
                            " (exit " exit "): " (str/join " " command)
                            (when (seq err) (str "\n" err)))
                       (assoc r :command (vec command)))))
     r)))

;; --- in-memory writer (ADR 0089; the java.io.StringWriter analog) ------------
;;
;; The PUBLIC handle `(binding [*out* w] …)` needs. cljgo has no java.io, so
;; `(java.io.StringWriter.)` cannot be written; `with-out-str` covers
;; whole-body capture and cljx.test's `capturing` covers a test body, but both
;; own the binding themselves. These two fns expose the very same in-memory
;; writer those macros ride on (clojure.core's -string-writer substrate,
;; corelib/builtins.go) so a caller can hold one, bind *out* to it across
;; several forms, and read it back — no second mechanism, no new host shim.
;;
;;   (let [w (io/string-writer)]
;;     (binding [*out* w] (println "hi") (print "x"))
;;     (io/writer-str w))            ;=> "hi\nx"
;;
;; oracle (clojure 1.12.5, 2026-07-28): the same shape on the JVM —
;;   (let [w (java.io.StringWriter.)]
;;     (binding [*out* w] (println "hi") (print "x")) (str w))  ;=> "hi\nx"
;; cljgo's reader is `writer-str` rather than `str` (a cljgo writer is a Go
;; io.Writer, not a JVM object whose toString is its buffer).

(defn string-writer
  "A fresh in-memory writer *out* can be bound to — the java.io.StringWriter
  analog. Read what has been written to it with `writer-str`."
  []
  (clojure.core/-string-writer))

(defn writer-str
  "Everything written to `w` (a `string-writer`) so far, as a String — the
  (str a-StringWriter) analog. Non-destructive: the writer keeps accumulating."
  [w]
  (clojure.core/-string-writer-str w))
